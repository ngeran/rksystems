---
const items = [
  "Άμεση κλήση Αστυνομίας",
  "Video Verification",
  "Ειδοποίηση διακοπής ρεύματος",
  "Έλεγχος σωστής όπλισης",
];
---

<section id="monitoring" class="w-full py-24 relative bg-primary-container border-b border-outline-variant">
  <div class="max-w-[1280px] mx-auto px-lg">
    <div class="flex flex-col md:flex-row gap-16 items-start">
      <div class="flex flex-col gap-4 min-w-[200px]">
        <div class="flex gap-2 font-mono-sm text-[11px] uppercase tracking-wider">
          <span class="bg-on-surface text-surface px-2 py-1 rounded-sm font-bold">SERVICE</span>
          <span class="border border-on-surface/20 text-on-surface px-2 py-1 rounded-sm">24/7</span>
        </div>
        <span class="text-[140px] font-display text-on-surface tracking-tighter leading-none -mt-4">04</span>
      </div>
      <div class="flex-1 flex flex-col gap-6">
        <h2 class="text-[40px] leading-tight font-display text-on-surface tracking-tight uppercase">
          24/7 Σύνδεση με Κέντρο Λήψης Σημάτων
        </h2>
        <p class="text-body-lg font-body-md text-on-primary-container max-w-2xl leading-relaxed">
          Συνδέουμε τα συστήματα Hikvision και Ajax με κορυφαία αδειοδοτημένα Κέντρα Λήψης Σημάτων για άμεση
          επέμβαση και 24ωρη προστασία.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-6 pt-8 border-t border-on-surface/10">
          {
            items.map((item) => (
              <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-on-surface text-[24px]">verified</span>
                <span class="font-mono-sm text-[14px] uppercase tracking-wider text-on-surface font-bold">
                  {item}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
