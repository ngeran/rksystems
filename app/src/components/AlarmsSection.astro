---
import NumberedSection from "./NumberedSection.astro";
import FeatureCard from "./FeatureCard.astro";

// 1. Import local assets
import axproImg from "../assets/axpro.jpg";
import ajaxImg from "../assets/ajax.jpg";
---

<NumberedSection
  id="alarms"
  number="03"
  title="Συστήματα Συναγερμού"
  tags={[{ label: "AX PRO HUB" }, { label: "AJAX SYSTEMS", variant: "outline" }]}
  bg="muted"
>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <FeatureCard
      badges={[{ label: "HIKVISION" }, { label: "AX PRO", variant: "neutral" }]}
      code="HW.AX"
      kicker="Black Series"
      heading="Wireless Hub System"
      bullets={[
        { title: "Tri-X & CAM-X Protocol", desc: "Ασύρματη εμβέλεια έως 2.000 μέτρα." },
        { title: "PIRCAM & IVAS", desc: "Άμεση λήψη φωτογραφιών/GIF κατά την παραβίαση." },
        { title: "Multi-Channel Connectivity", desc: "Σύνδεση Wi-Fi, LAN και Dual SIM 4G." },
      ]}
      /* 2. Using imported axproImg object */
      imageSrc={axproImg}
      imageAlt="AX PRO Hub Black edition rendering asset"
    />
    <FeatureCard
      badges={[{ label: "AJAX" }, { label: "GRADE 2", variant: "neutral" }]}
      code="HW.AJX"
      kicker="Smart Security"
      heading="Wireless Security Ecosystem"
      bullets={[
        { title: "Jeweller & Wings", desc: "Κρυπτογραφημένη ασύρματη επικοινωνία." },
        { title: "OS Malevich Shield", desc: "Πλοήγηση από παρεμβολές (Anti-jamming)." },
        { title: "Smart Scenarios", desc: "Αυτοματισμοί φωτισμού, ρελέ και ανίχνευση διαρροών." },
      ]}
      /* 2. Using imported ajaxImg object */
      imageSrc={ajaxImg}
      imageAlt="Ajax wireless security devices group"
    />
  </div>
</NumberedSection>
