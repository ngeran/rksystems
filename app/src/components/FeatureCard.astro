---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Badge {
  label: string;
  variant?: "primary" | "neutral";
}

interface Bullet {
  title: string;
  desc: string;
}

interface Props {
  badges: Badge[];
  code: string;
  kicker: string;
  heading: string;
  bullets: Bullet[];
  // UPDATED: imageSrc now accepts both strings (URLs) and ImageMetadata (Imports)
  imageSrc?: string | ImageMetadata;
  imageAlt?: string;
}

const { badges, code, kicker, heading, bullets, imageSrc, imageAlt = "" } = Astro.props;
---

<div class="slide-in-card border border-outline-variant bg-surface rounded-md overflow-hidden flex flex-col group shadow-sm hover:shadow-md transition-shadow">
  
  <div class="h-56 md:h-64 relative overflow-hidden bg-surface-container-lowest">
    <slot name="image">
      {imageSrc && (
        typeof imageSrc === 'string' ? (
          /* Handle external URLs */
          <img src={imageSrc} alt={imageAlt} loading="lazy" class="w-full h-full object-cover" />
        ) : (
          /* Handle local imported assets (Fixes [object Object]) */
          <Image 
            src={imageSrc} 
            alt={imageAlt} 
            width={800} 
            height={600} 
            class="w-full h-full object-cover grayscale opacity-90 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" 
          />
        )
      )}
    </slot>
  </div>

  <div class="p-5 border-t border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest">
    <!-- REMOVED: uppercase and tracking-wider -->
    <div class="flex gap-2 font-mono-sm text-[11px]">
      {
        badges.map((badge) => (
          <span
            class:list={[
              "px-2 py-1 rounded-sm",
              badge.variant === "neutral"
                ? "bg-surface-variant text-on-surface-variant"
                : "bg-primary-container text-on-primary-container font-bold",
            ]}
          >
            {badge.label}
          </span>
        ))
      }
    </div>
    <span class="text-mono-sm text-on-surface-variant font-bold">{code}</span>
  </div>

  <div class="p-8 flex flex-col gap-6 flex-1">
    <!-- REMOVED: uppercase from kicker -->
    <div class="font-mono-sm text-headline-lg-mobile tracking-widest text-on-surface border-b border-outline-variant pb-4">
      {kicker}
    </div>
    <!-- REMOVED: uppercase and tracking-wider from heading -->
    <h3 class="text-body-lg font-bold text-on-surface">{heading}</h3>
    
    <ul class="flex flex-col gap-4 mt-2">
      {
        bullets.map((bullet) => (
          <li class="flex items-start gap-3">
            <span class="text-primary-container font-mono-sm mt-1 text-lg leading-none">▪</span>
            <div>
              <!-- REMOVED: uppercase and tracking-wider from bullet titles -->
              <span class="font-mono-sm text-[12px] font-bold text-on-surface block mb-1">
                {bullet.title}
              </span>
              <span class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">
                {bullet.desc}
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".slide-in-card:not([data-observed])");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const target = entry.target as HTMLElement;
        const delay = Number(target.dataset.revealDelay ?? 0);
        window.setTimeout(() => target.classList.add("active"), delay);
        observer.unobserve(target);
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
  );

  cards.forEach((card, i) => {
    card.dataset.observed = "true";
    card.dataset.revealDelay = String((i % 4) * 90);
    observer.observe(card);
  });
</script>
