---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  badges: { label: string; variant?: "primary" | "neutral" }[];
  code: string;
  kicker: string;
  heading: string;
  bullets: { title: string; desc: string }[];
  imageSrc?: string | ImageMetadata;
  imageAlt?: string;
}

const { badges, code, kicker, heading, bullets, imageSrc, imageAlt = "" } = Astro.props;
---

<div class="border border-outline-variant bg-surface rounded-md overflow-hidden flex flex-col group shadow-sm transition-all">
  <!-- Image Container: Filters and Zooms removed -->
  <div class="h-56 md:h-64 relative overflow-hidden bg-surface-container-low">
    <slot name="image">
      {imageSrc && (
        typeof imageSrc === 'string' ? (
          <img src={imageSrc} alt={imageAlt} loading="lazy" class="w-full h-full object-cover" />
        ) : (
          <Image src={imageSrc} alt={imageAlt} width={800} height={600} class="w-full h-full object-cover" />
        )
      )}
    </slot>
  </div>

  <div class="p-5 border-t border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest">
    <div class="flex gap-2 font-mono-sm text-[11px]">
      {badges.map((badge) => (
        <span class:list={[
          "px-2 py-1 rounded-sm",
          badge.variant === "neutral" ? "bg-surface-variant text-on-surface-variant" : "bg-primary-container text-on-primary-container font-bold"
        ]}>
          {badge.label}
        </span>
      ))}
    </div>
    <span class="text-mono-sm text-on-surface-variant font-bold">{code}</span>
  </div>

  <div class="p-8 flex flex-col gap-6 flex-1">
    <div class="font-mono-sm text-headline-lg-mobile tracking-widest text-on-surface border-b border-outline-variant pb-4">
      {kicker}
    </div>
    <h3 class="text-body-lg font-bold text-on-surface">{heading}</h3>
    <ul class="flex flex-col gap-4 mt-2">
      {bullets.map((bullet) => (
        <li class="flex items-start gap-3">
          <span class="text-primary-container font-mono-sm mt-1 text-lg leading-none">▪</span>
          <div>
            <span class="font-mono-sm text-[12px] font-bold text-on-surface block mb-1">{bullet.title}</span>
            <span class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">{bullet.desc}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</div>
