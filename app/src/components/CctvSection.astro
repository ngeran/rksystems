---
import { Image } from "astro:assets";
import NumberedSection from "./NumberedSection.astro";
import FeatureCard from "./FeatureCard.astro";

import colorvuImg from "../assets/colorvu-acusense.jpg";
import nvrImg from "../assets/nvr-acuseek.jpeg";
import dahuaImg from "../assets/dahua.jpg";

const cctvCards = [
  {
    badges: [{ label: "HIKVISION PRIMARY" }, { label: "CCTV AI", variant: "neutral" as const }],
    code: "HW.CV3",
    kicker: "COLORVU 3.0 & ACUSENSE AI",
    heading: "ColorVu 3.0 & AcuSense AI Dome Cameras",
    bullets: [
      { title: "ColorVu 3.0", desc: "Έγχρωμη εικόνα 24/7 σε απόλυτο σκοτάδι με διάφραγμα F1.0." },
      { title: "AcuSense AI", desc: "Αναγνώριση ανθρώπων και οχημάτων με ακρίβεια 99%." },
      { title: "Audio 2.0", desc: "Αμφίδρομος ήχος & κορυφαία προστασία από διάβρωση." },
    ],
    image: colorvuImg,
    alt: "Hikvision ColorVu camera asset",
  },
  {
    badges: [{ label: "AI AGENT CLOUD" }, { label: "CCTV AI", variant: "neutral" as const }],
    code: "SW.NVR",
    kicker: "ACUSEEK NVR & AI AGENT",
    heading: "Hikvision AcuSeek NVR & Elasticsearch AI Search",
    bullets: [
      { title: "Natural Language Search", desc: "Εύρεση συμβάντων με απλή περιγραφή κειμένου." },
      { title: "Elasticsearch Engine", desc: "Άμεση ανεύρεση οχήματος/στόχου σε δευτερόλεπτα." },
      { title: "Hik-Connect App", desc: "Ζωντανή εικόνα και άμεσες ειδοποιήσεις στο κινητό σας." },
    ],
    image: nvrImg,
    alt: "Hikvision AcuSeek NVR hardware",
  },
  {
    badges: [{ label: "DAHUA PRO ACTIVE" }, { label: "CCTV AI", variant: "neutral" as const }],
    code: "HW.TIOC",
    kicker: "DAHUA TIOC 4K SYSTEM",
    heading: "Dahua TiOC 4K Active Deterrence Surveillance",
    bullets: [
      { title: "Full-Colour 4K", desc: "Υψηλή ανάλυση ημέρα & νύχτα." },
      { title: "Ενεργή Αποτροπή", desc: "Κόκκινο/Μπλε Flash Strobe και σειρήνα 110dB." },
      { title: "Smart Dual Light", desc: "Αυτόματη εναλλαγή IR και θερμού LED φωτός." },
    ],
    image: dahuaImg,
    alt: "Dahua Active Deterrence Camera product view",
  },
];
---

<NumberedSection
  id="cctv"
  number="02"
  title="Κάμερες CCTV & AI Ανάλυση"
  tags={[{ label: "HIKVISION FOCUS" }, { label: "DAHUA SOLUTIONS", variant: "outline" }]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      cctvCards.map((card) => (
        <FeatureCard badges={card.badges} code={card.code} kicker={card.kicker} heading={card.heading} bullets={card.bullets}>
          <Image
            slot="image"
            src={card.image}
            alt={card.alt}
            width={800}
            height={600}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </FeatureCard>
      ))
    }
  </div>
</NumberedSection>
