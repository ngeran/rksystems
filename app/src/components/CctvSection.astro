---
import { Image } from "astro:assets";
import NumberedSection from "./NumberedSection.astro";

// 1. Import local assets
import colorvuImg from "../assets/colorvu-acusense.jpg";
import nvrImg from "../assets/nvr-acuseek.jpeg";
import dahuaImg from "../assets/Dahua_Cameras-Full-Colour_24_7.webp";

const cctvCards = [
  {
    tag: "HIKVISION PRIMARY",
    code: "HW.CV3",
    kicker: "COLORVU 3.0 & ACUSENSE AI",
    title: "ColorVu 3.0 & AcuSense AI Dome Cameras",
    bullets: [
      { title: "ColorVu 3.0", desc: "Έγχρωμη εικόνα 24/7 σε απόλυτο σκοτάδι με διάφραγμα F1.0." },
      { title: "AcuSense AI", desc: "Αναγνώριση ανθρώπων και οχημάτων με ακρίβεια 99%." },
      { title: "Audio 2.0", desc: "Αμφίδρομος ήχος & κορυφαία προστασία από διάβρωση." }
    ],
    image: colorvuImg, // Reference imported variable
    alt: "Hikvision ColorVu camera asset"
  },
  {
    tag: "AI AGENT CLOUD",
    code: "SW.NVR",
    kicker: "ACUSEEK NVR & AI AGENT",
    title: "Hikvision AcuSeek NVR & Elasticsearch AI Search",
    bullets: [
      { title: "Natural Language Search", desc: "Εύρεση συμβάντων με απλή περιγραφή κειμένου." },
      { title: "Elasticsearch Engine", desc: "Άμεση ανεύρεση οχήματος/στόχου σε δευτερόλεπτα." },
      { title: "Hik-Connect App", desc: "Ζωντανή εικόνα και άμεσες ειδοποιήσεις στο κινητό σας." }
    ],
    image: nvrImg, // Reference imported variable
    alt: "Hikvision AcuSeek NVR hardware"
  },
  {
    tag: "DAHUA PRO ACTIVE",
    code: "HW.TIOC",
    kicker: "DAHUA TIOC 4K SYSTEM",
    title: "Dahua TiOC 4K Active Deterrence Surveillance",
    bullets: [
      { title: "Full-Colour 4K", desc: "Υψηλή ανάλυση ημέρα & νύχτα." },
      { title: "Ενεργή Αποτροπή", desc: "Κόκκινο/Μπλε Flash Strobe και σειρήνα 110dB." },
      { title: "Smart Dual Light", desc: "Αυτόματη εναλλαγή IR και θερμού LED φωτός." }
    ],
    image: dahuaImg, // Reference imported variable
    alt: "Dahua Active Deterrence Camera product view"
  }
];
---

<NumberedSection
  id="cctv"
  number="02"
  title="Κάμερες CCTV & AI Ανάλυση"
  tags={[{ label: "HIKVISION FOCUS" }, { label: "DAHUA SOLUTIONS", variant: "outline" }]}
>
  <div class="pin-container relative -mx-md md:-mx-lg">

    {/* Kurosawa Style Pagination Bar */}
    <div class="flex items-center justify-end gap-6 px-md md:px-lg mb-8">
      <div class="flex items-center gap-4">
        <div class="pin-dots flex items-center gap-2">
          {cctvCards.map((_, i) => (
            <i
              data-index={i}
              class={`dot h-1.5 rounded-full transition-all duration-500 ease-out bg-primary-container ${i === 0 ? 'w-6 opacity-100' : 'w-2 opacity-30'}`}
            ></i>
          ))}
        </div>
        <div class="font-mono-sm text-[12px] text-on-surface-variant font-bold tracking-widest">
          <span id="current-idx" class="text-on-surface">01</span> / 0{cctvCards.length}
        </div>
      </div>
    </div>

    {/* Horizontal Track */}
    <div class="htrack flex flex-nowrap gap-10 px-md md:px-lg will-change-transform">
      {cctvCards.map((card) => (
        <div class="hcard flex-shrink-0 w-[90vw] md:w-[866px] border border-outline-variant bg-surface rounded-md flex flex-col group shadow-sm hover:shadow-md transition-shadow">

          {/* Top Info Bar */}
          <div class="p-5 border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest rounded-t-md">
            <div class="flex gap-2 font-mono-sm text-[11px] uppercase tracking-wider">
              <span class="bg-primary-container text-on-primary-container px-2 py-1 rounded-sm font-bold">{card.tag}</span>
              <span class="bg-surface-variant text-on-surface-variant px-2 py-1 rounded-sm">CCTV AI</span>
            </div>
            <span class="text-mono-sm text-on-surface-variant font-mono-sm font-bold">{card.code}</span>
          </div>

          {/* Contents Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 flex-1">

            {/* Specs left */}
            <div class="p-8 flex flex-col gap-6">
              <div class="font-mono-sm text-headline-lg-mobile tracking-widest text-on-surface border-b border-outline-variant pb-4 uppercase">
                {card.kicker}
              </div>
              <h3 class="text-body-lg font-bold text-on-surface uppercase tracking-wider">
                {card.title}
              </h3>
              <ul class="flex flex-col gap-4 mt-2">
                {card.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <span class="text-primary-container font-mono-sm mt-1 text-lg leading-none">▪</span>
                    <div>
                      <span class="font-mono-sm text-[12px] font-bold text-on-surface block uppercase tracking-wider mb-1">
                        {bullet.title}
                      </span>
                      <span class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">
                        {bullet.desc}
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            {/* Image right - 2. Updated to Astro <Image /> */}
            <div class="h-72 md:h-auto border-t md:border-t-0 md:border-l border-outline-variant relative overflow-hidden">
              <Image
                src={card.image}
                alt={card.alt}
                width={800} 
                height={600}
                class="w-full h-full object-cover grayscale opacity-90 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                loading="lazy"
              />
            </div>

          </div>
        </div>
      ))}
      <div class="flex-shrink-0 w-[20vw]"></div>
    </div>
  </div>
</NumberedSection>

<!-- Scripts and Styles remain identical -->
<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  if (typeof window !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    const setupScroll = () => {
      const track = document.querySelector('.htrack');
      const section = document.querySelector('#cctv');
      const dots = document.querySelectorAll('.dot');
      const currentIdxText = document.querySelector('#current-idx');

      if (!track || !section) return;

      const cardCount = dots.length;

      gsap.to(track, {
        x: () => -(track.scrollWidth - window.innerWidth + (window.innerWidth * 0.15)),
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top 116px",
          end: () => `+=${track.scrollWidth}`,
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            const activeIndex = Math.min(Math.floor(self.progress * cardCount), cardCount - 1);

            dots.forEach((dot, i) => {
              const htmlDot = dot as HTMLElement;
              if (i === activeIndex) {
                htmlDot.style.width = '24px';
                htmlDot.style.opacity = '1';
              } else {
                htmlDot.style.width = '8px';
                htmlDot.style.opacity = '0.3';
              }
            });

            if (currentIdxText) {
              currentIdxText.textContent = `0${activeIndex + 1}`;
            }
          }
        }
      });
    };

    setupScroll();
    document.addEventListener('astro:after-swap', setupScroll);
  }
</script>

<style>
  :global(body) {
    overflow-x: hidden;
  }
</style>
