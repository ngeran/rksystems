---
import NumberedSection from "./NumberedSection.astro";
import FeatureCard from "./FeatureCard.astro";

// 1. IMPORT LOCAL ASSETS
import unifiImg from "../assets/unifi.jpg";
import omadaImg from "../assets/omada.webp";
import mikrotikImg from "../assets/mikrotik.webp";
---

<NumberedSection
  id="networks"
  number="05"
  title="Επαγγελματικά Δίκτυα & Wi-Fi"
  tags={[{ label: "UBIQUITI UNIFI" }, { label: "TP-LINK OMADA", variant: "outline" }, { label: "MIKROTIK", variant: "outline" }]}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <FeatureCard
      badges={[{ label: "UBIQUITI" }, { label: "UNIFI", variant: "neutral" }]}
      code="NW.UI"
      kicker="WI-FI 6/7 NETWORKS"
      heading="Ubiquiti UniFi Systems"
      bullets={[
        { title: "UniFi OS Console", desc: "Κεντρική διαχείριση Access Points & Switches." },
        { title: "Seamless Roaming", desc: "Σταθερή κάλυψη Wi-Fi παντού χωρίς αποσυνδέσεις." },
        { title: "VLAN Segmentation", desc: "Πλήρης διαχωρισμός δικτύου CCTV, Guest & Office." },
      ]}
      imageSrc={unifiImg}
      imageAlt="Ubiquiti UniFi network hardware stack"
    />
    
    <FeatureCard
      badges={[{ label: "TP-LINK" }, { label: "OMADA", variant: "neutral" }]}
      code="NW.TPL"
      kicker="CLOUD SDN ARCH"
      heading="TP-Link Omada SDN"
      bullets={[
        { title: "Cloud Controllers", desc: "100% απομακρυσμένη διαχείριση." },
        { title: "Managed PoE Switches", desc: "Σταθερή τροφοδοσία καμερών CCTV και συσκευών." },
        { title: "Captive Portal", desc: "Wi-Fi vouchers και guest isolation για καταστήματα." },
      ]}
      imageSrc={omadaImg}
      imageAlt="TP Link Omada network equipment range"
    />
    
    <FeatureCard
      badges={[{ label: "MIKROTIK" }, { label: "ROUTING", variant: "neutral" }]}
      code="NW.MKT"
      kicker="ADVANCED OS"
      heading="MikroTik RouterOS"
      bullets={[
        { title: "Dual-WAN Failover", desc: "Αυτόματη εναλλαγή εφεδρικής γραμμής internet." },
        { title: "WireGuard & IPsec VPN", desc: "Ασφαλής σύνδεση απομακρυσμένων σημείων." },
        { title: "Advanced QoS Profiles", desc: "Απόλυτη προτεραιότητα ταχύτητας σε CCTV και POS." },
      ]}
      imageSrc={mikrotikImg}
      imageAlt="MikroTik routers setup view"
    />
  </div>
</NumberedSection>
