---
import { Image } from "astro:assets";
import NumberedSection from "./NumberedSection.astro";
import intercomImg from "../assets/hikvision-intercom.webp";
---

<NumberedSection id="intercom" number="04" title="Smart IP Θυροτηλεοράσεις" tags={[{ label: "HIKVISION IP & 2-WIRE" }]}>
  <div class="border border-outline-variant bg-surface rounded-md flex flex-col group shadow-sm transition-all">
    <div class="p-5 border-b border-outline-variant flex justify-between items-center bg-surface-container-lowest rounded-t-md">
      <div class="flex gap-2 font-mono-sm text-[11px] tracking-wider">
        <span class="bg-primary-container text-on-primary-container px-2 py-1 rounded-sm font-bold">HIKVISION</span>
        <span class="bg-surface-variant text-on-surface-variant px-2 py-1 rounded-sm">IP INTERCOM</span>
      </div>
      <span class="text-mono-sm text-on-surface-variant font-mono-sm font-bold"></span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div class="p-8 flex flex-col gap-6">
        <div class="font-mono-sm text-headline-lg-mobile tracking-widest text-on-surface border-b border-outline-variant pb-4">Entry Control Systems</div>
        <h3 class="text-body-lg font-bold text-on-surface">Έλεγχος Εισόδου & Απομακρυσμένο Άνοιγμα Πόρτας</h3>
        <p class="font-mono-sm text-[12px] text-on-surface-variant leading-relaxed">
          Αναβάθμιση παλαιών θυροτηλεφώνων σε υπερσύγχρονα συστήματα <strong>Hikvision IP / 2-Wire HD</strong>.
        </p>
        <ul class="flex flex-col gap-4 mt-2">
          {[
            { title: "Άνοιγμα από το Κινητό", desc: "Απάντηση κλήσης και άνοιγμα πόρτας από οπουδήποτε." },
            { title: "Τεχνολογία 2-Wire HD", desc: "Εγκατάσταση στην υπάρχουσα καλωδίωση." }
          ].map((bullet) => (
            <li class="flex items-start gap-3">
              <span class="text-primary-container font-mono-sm mt-1 text-lg leading-none">▪</span>
              <div>
                <span class="font-mono-sm text-[12px] font-bold text-on-surface block mb-1">{bullet.title}</span>
                <span class="font-body-md text-[14px] text-on-surface-variant">{bullet.desc}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="h-72 lg:h-auto border-t lg:border-t-0 lg:border-l border-outline-variant relative overflow-hidden">
        <Image src={intercomImg} alt="Hikvision Video Intercom" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </div>
</NumberedSection>
