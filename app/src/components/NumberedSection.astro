---
interface Tag {
  label: string;
  variant?: "filled" | "outline";
}

interface Props {
  id: string;
  number: string;
  title: string;
  tags?: Tag[];
  bg?: "default" | "muted";
}

const { id, number, title, tags = [], bg = "default" } = Astro.props;

const backgroundClass = bg === "muted" ? "bg-surface-container-low" : "bg-background";
---
<section id={id} class={`w-full py-20 lg:py-24 relative border-b border-outline-variant ${backgroundClass}`}>
  <div class="max-w-[1280px] mx-auto px-md md:px-lg flex flex-col lg:flex-row gap-12 lg:gap-16">
    
    <!-- Left Number Block -->
    <div class="w-full lg:w-48 flex-shrink-0">
      <span class="text-[90px] lg:text-[130px] font-display text-primary-container leading-none tracking-tighter block -mt-6 select-none">
        {number}
      </span>
    </div>

    <!-- Right Content Block -->
    <div class="flex-1 min-w-0">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-outline-variant gap-4">
        <h2 class="text-headline-lg font-display text-on-surface uppercase tracking-tight">{title}</h2>
        
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class={`text-[10px] font-mono-sm uppercase tracking-widest px-3 py-1 rounded-xs font-bold ${
                tag.variant === "outline" 
                  ? "text-on-surface-variant border border-outline-variant" 
                  : "text-on-surface bg-surface-variant"
              }`}>
                {tag.label}
              </span>
            ))}
          </div>
        )}
      </div>
      
      <!-- Component Content Slot -->
      <slot />
    </div>
  </div>
</section>
